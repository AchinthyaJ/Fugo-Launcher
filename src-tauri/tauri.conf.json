{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fugo Launcher",
  "version": "4.0.3",
  "identifier": "com.fugo.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fugo Launcher",
        "width": 1180,
        "height": 740,
        "minWidth": 940,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
